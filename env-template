# Optional Settings
LOG_LEVEL=INFO 

# VITE Config
VITE_USE_LOCAL_API=true

# Environment variables secret name
ENVIRONMENT_VARIABLES_SECRET_NAME=PROJECT_NAME_PLACEHOLDER-infra-dev-EnvironmentVariables
