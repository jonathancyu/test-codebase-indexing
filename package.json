{
  "name": "PROJECT_NAME_PLACEHOLDER",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "fetch-config": "pnpm dlx @8090-inc/fetch-config@latest dev frontend/public -s PROJECT_NAME_PLACEHOLDER-infra-dev",
    "db:start": "cd backend && docker-compose up -d",
    "db:stop": "cd backend && docker-compose down",
    "db:reset": "cd backend && docker-compose down -v && docker-compose up -d",
    "db:migrate": "cd backend && export LOCAL_DATABASE=true && ./start_db_migrations.sh",
    "backend:dev": "cd backend && export LOCAL_DATABASE=true && export ENVIRONMENT_VARIABLES_SECRET_NAME=PROJECT_NAME_PLACEHOLDER-infra-dev-EnvironmentVariables && poetry run uvicorn src.app:app --reload",
    "dev": "pnpm db:start && pnpm db:migrate && pnpm backend:dev",
    "dev:fresh": "pnpm db:reset && pnpm db:migrate && pnpm backend:dev",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@8090-inc/fetch-config": "^0.2.3",
    "@aws-sdk/client-cloudformation": "^3.830.0",
    "@aws-sdk/client-s3": "^3.830.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "eslint": "~8.57.1",
    "eslint-config-next": "^15.3.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^27.9.0",
    "eslint-plugin-prettier": "^5.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
